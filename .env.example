# 复制为 .env 后按需修改（也可以直接在命令行设置环境变量；已有的环境变量优先）
# 数据源：sqlite = 真实数据（默认）；mock = 演示数据（也可以用 npm run dev:mock）
EMAKI_DATA_SOURCE=sqlite
# 数据库、缩略图缓存的位置（相对路径按仓库根目录解析）
EMAKI_DATA_DIR=./data
# 识别模型的位置（不设 = <数据目录>/models；多个数据目录可共用一份）
# EMAKI_MODELS_DIR=./data/models
# 后端端口（前端开发服务器固定 5173，会把 /api 代理到这里）
EMAKI_PORT=5174
# 只监听本机；不要改成 0.0.0.0，除非你清楚后果
EMAKI_HOST=127.0.0.1
# 日志级别：fatal / error / warn / info / debug
EMAKI_LOG_LEVEL=info
# 出网代理（下载模型、同步 Danbooru 用），例如 Clash：http://127.0.0.1:7890
# EMAKI_HTTP_PROXY=
# Hugging Face 镜像，例如 https://hf-mirror.com
# HF_ENDPOINT=

{
  "name": "emaki",
  "private": true,
  "version": "0.1.7",
  "description": "Emaki 絵巻 — 本地二次元插画收藏管理器：按角色/作品整理、自动识别、查重。",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev -w @emaki/server\" \"npm:dev -w @emaki/web\"",
    "dev:mock": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:mock -w @emaki/server\" \"npm:dev -w @emaki/web\"",
    "dev:web": "npm run dev -w @emaki/web",
    "dev:server": "npm run dev -w @emaki/server",
    "build": "npm run build -w @emaki/web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:server": "npm run start -w @emaki/server"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": false,
    "onnxruntime-node@1.30.0": true
  }
}

{
  "id": "pixiv-browser",
  "name": "Pixiv 浏览",
  "version": "0.3.0",
  "description": "在 Emaki 里逛 Pixiv，多选以后批量下载进图库（相同的图不会再放一份）。手机、平板的 App 里直接打开 Pixiv 网站本身，加上多选和「下载到 Emaki」；电脑上是 Emaki 里的浏览页（排行、搜索、关注）。随 Emaki 附带，默认没装。",
  "author": "Emaki",
  "engines": {
    "emaki": ">=0.1.17"
  },
  "permissions": {
    "scopes": ["read", "import"],
    "folders": [
      {
        "id": "downloads",
        "purpose": "下载的图放在这里",
        "suggest": "下载图片/Pixiv"
      }
    ],
    "network": ["www.pixiv.net", "i.pximg.net"],
    "background": true
  },
  "contributes": {
    "page@1": [
      {
        "id": "browse",
        "view": "views/browse.html",
        "title": "Pixiv",
        "site": "pixiv"
      }
    ],
    "site@1": [
      {
        "id": "pixiv",
        "title": "Pixiv",
        "url": "https://www.pixiv.net/",
        "matches": ["www.pixiv.net"],
        "script": "site/pixiv.js"
      }
    ],
    "nav.item@1": [
      {
        "id": "browse",
        "label": "Pixiv",
        "page": "browse",
        "icon": "compass",
        "section": "main"
      }
    ],
    "command@1": [
      {
        "name": "pixiv-browser.ranking",
        "summary": "Pixiv 的排行（日、周、月、新人、原创、AI、男性向、女性向；R-18 的要先登录）",
        "scope": "read",
        "input": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["daily", "weekly", "monthly", "rookie", "original", "daily_ai", "male", "female", "daily_r18", "weekly_r18"]
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{8}$"
            }
          }
        }
      },
      {
        "name": "pixiv-browser.search",
        "summary": "按标签、关键词搜 Pixiv 的插画（R-18 的要先登录）",
        "scope": "read",
        "input": {
          "type": "object",
          "properties": {
            "word": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "order": {
              "type": "string",
              "enum": ["date_d", "date"]
            },
            "mode": {
              "type": "string",
              "enum": ["safe", "all", "r18"]
            },
            "match": {
              "type": "string",
              "enum": ["tag", "partial", "text"]
            }
          },
          "required": ["word"]
        }
      },
      {
        "name": "pixiv-browser.following",
        "summary": "关注的画师的新作（要先登录 Pixiv）",
        "scope": "read",
        "input": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "r18": {
              "type": "boolean"
            }
          }
        }
      },
      {
        "name": "pixiv-browser.thumbs",
        "summary": "把 Pixiv 的缩略图取到插件的文件夹（页面里显示用）",
        "scope": "read",
        "input": {
          "type": "object",
          "properties": {
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 60
            }
          },
          "required": ["urls"]
        }
      },
      {
        "name": "pixiv-browser.status",
        "summary": "登录了哪个账号（正在登录、上次登录失败的原因）；这些作品里哪些已经下载过",
        "scope": "read",
        "input": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 500
            }
          }
        }
      },
      {
        "name": "pixiv-browser.login",
        "summary": "登录 Pixiv：在电脑上弹出 Pixiv 的登录页，登录好窗口自己关掉",
        "scope": "read"
      },
      {
        "name": "pixiv-browser.logout",
        "summary": "退出 Pixiv（删掉这个插件存的登录）",
        "scope": "read"
      },
      {
        "name": "pixiv-browser.download",
        "summary": "把这些 Pixiv 作品（全部页）下载进图库：后台任务，进度、取消在任务列表里；图库里已经有的不再放一份。works 可以带上标题和原图地址（i.pximg.net）",
        "scope": "import",
        "input": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d{1,12}$"
              },
              "maxItems": 200
            },
            "works": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^\\d{1,12}$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "urls": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "maxItems": 300
                  }
                },
                "required": ["id"]
              }
            }
          }
        }
      }
    ],
    "job.kind@1": [
      {
        "kind": "download",
        "label": "下载 Pixiv 作品"
      }
    ]
  },
  "server": "server/index.mjs"
}

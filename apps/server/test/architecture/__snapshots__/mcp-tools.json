  {
    "name": "catalog_verify_character",
    "command": "catalog.verifyCharacter",
    "scope": "catalog",
    "undoable": true,
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "本次操作的唯一标识，重试使用同一个值"
        },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "identity"
                },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\s:]+$"
                },
                "characterTag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\s:]+$"
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "form",
                    "same-character"
                  ]
                },
                "aliases": {
                  "default": [],
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "sources": {
                  "minItems": 1,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  }
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "type",
                "tag",
                "characterTag",
                "relation",
                "sources",
                "evidence"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "name"
                },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\s:]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "aliases": {
                  "default": [],
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "sources": {
                  "minItems": 1,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  }
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "type",
                "tag",
                "name",
                "sources",
                "evidence"
              ]
            }
          ]
        }
      },
      "required": [
        "operationId",
        "input"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
